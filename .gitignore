# ── Secrets & credentials — NEVER commit ──────────────────────────────────────
# Google/YouTube OAuth client secrets and per-account tokens.
# Ignore the secret files by name so a setup README in the folder can still be tracked.
youtube/credentials/**/client_secrets.json
youtube/credentials/**/*.pickle
youtube/credentials/**/*.pkl
youtube/credentials/**/token*.json
*.pickle
*.pkl
# Cookie exports (YouTube download auth)
cookies.txt
*cookies*.txt
# Local environment / secrets
.env
.env.*
!.env.example
# Machine-specific overrides (real PIN, tailnet SMB link, local interpreter path)
hub/local_settings.py
**/local_settings.py
# Machine-specific overrides for the .vbs launcher (real Tailscale hostname, PWA app id)
Agent Hub.local.vbs
# Generated per-machine (real repo path baked in) — see register-agenthub-protocol.reg.example
register-agenthub-protocol.reg
# Defensive: anything a tool marks machine-local, and stray secret files
*.local
# Editor/agent workspace config - local to whoever is working on this.
.claude/
secrets*.json
credentials*.json

# ── Backups & scratch ─────────────────────────────────────────────────────────
*.bak
*.orig
*.tmp

# ── Launcher logs (Agent Hub.vbs) — per-machine, never needed in the repo ──────
logs/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Windows / editor cruft ────────────────────────────────────────────────────
desktop.ini
Thumbs.db
.DS_Store

# Compiled-from-wiki skills (rebuilt on every hub start by skills_sync.py)
hub/agent_knowledge/skills_generated/

# Personal agent personas + per-agent LLM-setting overrides (yours, not the repo's)
hub/agent_knowledge/agents_user/
hub/agent_knowledge/agent_overrides.json
hub/agent_knowledge/model_policy.json
hub/apps.json
hub/ingested_apps/

# ── Build & release output — never in the repo (assets go to GitHub Releases) ──
build/
release/
.release-venv/
.release-work/
packaging/payloads/

# ── Build logs ────────────────────────────────────────────────────────────────
/*.log
build-exit.txt

# ── Per-machine runtime state ─────────────────────────────────────────────────
# Real disk layout for this machine — see hub/locations.example.json
hub/locations.json
# Learned PC-control routines, run history, and other local databases
hub/data/

# Release audit denylist (real PIN / account tag / tailnet address)
packaging/release-deny.local.txt
# Written by the build dialog when you confirm the clean-machine test.
release-evidence.json
